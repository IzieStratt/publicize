{
  "display_information": {
    "name": "Publicize",
    "description": "Admins, channel managers and channel creators can make a private channel public."
  },
  "features": {
    "bot_user": { "display_name": "publicize", "always_online": true },
    "slash_commands": [
      {
        "command": "/publicize",
        "description": "Make this private channel public (admins, channel managers, creators)",
        "should_escape": false
      }
    ]
  },
  "oauth_config": { "scopes": {
      "bot": ["commands"],
      "user": [
        "admin.conversations:write",
        "admin.conversations:read",
        "admin.roles:read",
        "users:read",
        "groups:read"
      ]
    } },
  "settings": {
    "org_deploy_enabled": true,
    "socket_mode_enabled": true,
    "interactivity": { "is_enabled": true },
    "token_rotation_enabled": false
  }
}
